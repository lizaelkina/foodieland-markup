dialog#modal-video(aria-label='Modal video').modal.js-modal
  div.modal__container
    button(type='button' aria-label='Close modal video').modal__close.js-modal-close
    div.modal__content
      iframe.modal__iframe.js-iframe(
        src=resipeData.srcVideo
        title="Recipe"
        allow='autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
        allowfullscreen
      )
