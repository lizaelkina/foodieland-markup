section(aria-labelledby='subscription-heading').content__container.subscribe.js-subscribe
  form(method='post').subscribe__form.js-subscribe-form
    div.subscribe__title-wrapper
      div.subscribe__title.js-subscribe-title
        h2#subscription-heading.visually-hidden Deliciousness to your inbox
        span.subscribe__title-text(
          aria-hidden='true'
          data-title='default') Deliciousness to your inbox
        span.subscribe__title-text(
          aria-hidden='true'
          data-title='success') Thanks for subscribing!
      p.subscribe__subtitle
        | Lorem ipsum dolor sit amet, consectetuipisicing elit, sed do eiusmod tempor
        | incididunt ut labore et dolore magna aliqut enim ad minim
    div.input
      label.visually-hidden(for='subscribe-email') Enter your email address
      input.input__field(
        id='subscribe-email'
        required
        type='email'
        name='subscribeEmail'
        autocomplete='email'
        placeholder='Your email address...')
      button(type='submit').button.input__submit.js-subscribe-submit
        span.button__text Subscribe
    span.visually-hidden.js-subscribe-status(role='status')
