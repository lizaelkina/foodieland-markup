section(aria-labelledby='instagram-heading').instagram
  div.content__container.content__container_slider.instagram__container
    +section-heading({
      id: 'instagram-heading',
      title: 'Check out @foodieland on Instagram',
      subtitle: 'Lorem ipsum dolor sit amet, consectetuipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqut enim ad minim',
    }).instagram__heading
    div.swiper.instagram__slider.js-instagram-slider
      div.swiper-wrapper
        div.swiper-slide.instagram__slide
          +card-inst({
            img: './img/inst-img-1',
            title: 'The vegetables dishes need to have certain vitamin for those people'
          })
        div.swiper-slide.instagram__slide
          +card-inst({
            img: './img/inst-img-2',
            title: 'Sweet food can bring someon into happiness as long as they don’t eat to much'
          })
        div.swiper-slide.instagram__slide
          +card-inst({
            img: './img/inst-img-3',
            title: 'What are you doing before start cooking? prepare the  tools or ingredients?'
          })
        div.swiper-slide.instagram__slide
          +card-inst({
            img: './img/inst-img-4',
            title: 'Steak never be wrong, it’s suitable for you who want romantic dinner'
          })
      +swiper-navigation('js-instagram-button-prev', 'js-instagram-button-next')
    +button-icon('Visit Our Instagram', 'instagram')(target='_blank' rel='noopener' aria-label='Visit Our Instagram (opens in new tab)')
