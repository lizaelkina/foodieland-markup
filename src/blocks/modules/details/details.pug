section(aria-labelledby='recipe-details-heading').content__container.details
  div.details__header
    h1#recipe-details-heading.details__title= resipeData.title || 'Recipe'
    div.author.details__author
      +img(resipeData.authorPhoto, '').author__photo
      a(href='#').author__name= resipeData.authorName
      +date(resipeData.authorDate).author__date
    div.details__labels
      div.details__column
        +label-timer-details('Prep time', resipeData.prepTime).label_details
      div.details__column
        +label-timer-details('Cook time', resipeData.cookTime).label_details
      div.details__column
        +label-category(resipeData.category)
    ul(aria-label='Page actions').details__buttons
      li
        +button-round('Print', 'printer')(onclick='window.print()')
      li
        +button-round('Share', 'share')(aria-haspopup='true' aria-expanded='false')
  div.details__information
    div.details__img-wrapper
      +img(resipeData.imgVideo, '')(
        loading='eager'
        fetchpriority='high'
        sizes='(max-width: 800px) calc(100vw - 32px), ' +
        '(max-width: 1024px) 36vw, ' +
        '(max-width: 1200px) 40vw, ' +
        '(max-width: 1400px) calc(51.5vw - 62px), 660px').details__img
      +button-play-video
    +nutrition
  p.details__text
