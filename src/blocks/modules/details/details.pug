article(aria-labelledby='recipe-details-heading').content__container.details
  +logo.details__logo-print
  div.details__intro
    header.details__header
      h1#recipe-details-heading.details__title= recipeData.title || 'Recipe'
      div.author.details__author
        +img(recipeData.authorPhoto, '').author__photo
        a(href='#').author__name= recipeData.authorName
        +date(recipeData.authorDate).author__date
      div.details__labels
        div.details__column
          +label-timer-details('Prep time', recipeData.prepTime).label_details
        div.details__column
          +label-timer-details('Cook time', recipeData.cookTime).label_details
        div.details__column
          +label-category(recipeData.category)
      ul(aria-label='Page actions').details__buttons
        li
          +button-round('Print', 'printer')(onclick='window.print()')
        li
          +button-round('Share', 'share')(aria-haspopup='true' aria-expanded='false')
    div.details__information
      div.details__img-wrapper
        +img(recipeData.imgVideo, recipeData.title)(loading='eager' fetchpriority='high' sizes=cardSizes.details).details__img
        +button-play-video
      +nutrition
