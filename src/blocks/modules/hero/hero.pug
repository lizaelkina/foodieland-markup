section(aria-labelledby='slider-heading').content__container.content__container_slider.hero
  h1#slider-heading.visually-hidden= site.name
  div.swiper.hero__slider.js-hero-slider
    div.swiper-wrapper
      each item, index in recipesBig
        div.swiper-slide.hero__slide
          +slide({...item, isFirst: index === 0}).hero__card
    +swiper-navigation('js-hero-button-prev', 'js-hero-button-next')
    div.swiper-pagination.hero__pagination.js-hero-pagination
