section(aria-labelledby='try-heading').recipes
  +section-heading({
    id: 'try-heading',
    title: 'Try this delicious recipe to make your day',
    subtitle: 'Lorem ipsum dolor sit amet, consectetuipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqut enim ad minim',
    sizeTitle: 'heading__title-section_type_row',
    sizeSubtitle: 'heading__subtitle_type_row'
  }).heading_row.recipes__heading
  div.content__container.recipes__container.recipes__container_small
    //- = down('mobile-wide'); must match not-down(mobile-wide) in recipes.scss
    div.swiper.recipes__slider.js-recipes-slider(data-swiper-media='(max-width: 640px)')
      div.swiper-wrapper.recipes__slider-wrapper
        each item in recipesTry
          div.swiper-slide.recipes__slide.recipes__slide_small
            +recipe-small({...item})
      div.swiper-pagination.recipes__pagination.recipes__pagination_small.js-recipes-pagination
