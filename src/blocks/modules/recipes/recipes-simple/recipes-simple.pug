section(aria-labelledby='simple-heading').recipes
  +section-heading({
    id: 'simple-heading',
    title: 'Simple and tasty recipes',
    subtitle: 'Lorem ipsum dolor sit amet, consectetuipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqut enim ad minim',
    sizeSubtitle: 'heading__subtitle_type_small'
  }).recipes__heading
  div.content__container.recipes__container
    //- = down('mobile-wide'); must match not-down(mobile-wide) in recipes.scss
    div.swiper.recipes__slider.js-recipes-slider(data-swiper-media='(max-width: 640px)')
      div.swiper-wrapper.recipes__slider-wrapper
        each item in recipesSimple
          div.swiper-slide.recipes__slide
            +recipe-big({...item})
      div.swiper-pagination.recipes__pagination.js-recipes-pagination
    aside.recipes__promo
      +promo.promo_recipes
