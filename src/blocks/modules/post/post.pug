article(aria-labelledby='blog-post-heading').content__container.post
  header.post__header
    div.heading.post__heading
      h1#blog-post-heading.heading__title-page= blogData.title || 'Blog'
      p.author.author_blog.post__author
        +img(blogData.authorPhoto, '')(loading='eager').author__photo.author__photo_blog
        a(href='#').author__name.author__name_blog= blogData.authorName
        +date(blogData.authorDate).author__date.author__date_blog
      p.heading__subtitle.heading__subtitle_type_big= blogData.subtitleFull
    +img(blogData.imgBig, 'Chef')(loading='eager' fetchpriority='high' sizes=cardSizes.bigImg).post__img
  div.post__container
    div.post__interview
