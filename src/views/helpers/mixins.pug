mixin pagination(data)
  - const { total, baseHref = '?page=', siblings = 1 } = data;
  if total >= 1
    - const hasGaps = total > siblings * 2 + 5;
    nav.pagination.js-pagination(aria-label='pagination' data-siblings=siblings)&attributes(attributes)
      ul.pagination__list
        each page in Array.from({length: total}, (_, i) => i + 1)
          if hasGaps && page === total
            li.js-pagination-gap(hidden)
              span.pagination__dots …
          li(data-page=page)
            a.pagination__item.js-pagination-item(href=`${baseHref}${page}`)= page
          if hasGaps && page === 1
            li.js-pagination-gap(hidden)
              span.pagination__dots …

