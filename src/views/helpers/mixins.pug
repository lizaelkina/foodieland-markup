mixin img(src, alt)
  -
    if (alt == null) {
      throw new Error(`+img: alt is required for "${src}", pass '' for a decorative image`);
    }
  -
    attributes.loading = attributes.loading === 'eager' ? false : attributes.loading || 'lazy';
    const size = imageSizes && imageSizes[src.replace(/^(\.\/)?img\//, '').replace(/\.[a-z0-9]+$/i, '')];
    if (size && attributes.width == null && attributes.height == null) {
      attributes.width = size.width;
      attributes.height = size.height;
    }
    if (attributes.sizes) {
      if (/\.[a-z0-9]+$/i.test(src) || !size) {
        throw new Error(`+img: sizes needs a PNG/JPEG/TIFF from src/img without an extension, got "${src}"`);
      }
      attributes.srcset = [...size.widths.map(width => `${src}-${width}w.webp ${width}w`), `${src}.webp ${size.width}w`].join(', ');
    }
  img(src=/\.[a-z0-9]+$/i.test(src) ? src : src + '.webp', alt=alt)&attributes(attributes)

mixin svg(name)
  svg(data-svg=name aria-hidden='true')&attributes(attributes)
    use(href=`./img/sprites/sprite.svg#${name}`)

mixin date(isoDate)
  -
    if (!/^\d{4}-\d{2}-\d{2}$/.test(isoDate)) {
      throw new Error(`+date: expected YYYY-MM-DD, got "${isoDate}"`);
    }
    const text = new Intl.DateTimeFormat('en-GB', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC'
    }).format(new Date(isoDate));
  time(datetime=isoDate)&attributes(attributes)= text

mixin external-link(name, href)
  a(href=href target='_blank' rel='noopener' aria-label=`${name} (opens in new tab)`)&attributes(attributes)= name

mixin link(name, href)
  a.link(href=href)&attributes(attributes)= name

mixin swiper-navigation(classPrev, classNext)
  button.swiper-button-prev(type='button' aria-label='Previous slide' disabled class=classPrev)
    +svg('swiper-arrow').swiper-navigation-icon
  button.swiper-button-next(type='button' aria-label='Next slide' disabled class=classNext)
    +svg('swiper-arrow').swiper-navigation-icon

mixin socials
  ul(aria-label=attributes['aria-labelledby'] ? null : 'Our socials').socials&attributes(attributes)
    each item in socials
      li
        a(
          href=item.href
          target='_blank'
          rel='noopener'
          aria-label=`${item.title} (opens in new tab)`
          class=['socials__link', `socials__link_${item.id}`])
          +svg(item.id).socials__svg

mixin nav-list(place, itemClass)
  -
    const places = ['header', 'menu', 'footer'];
    const unknown = [place, ...nav.flatMap(item => item.hideIn || [])].find(name => !places.includes(name));
    if (unknown !== undefined) {
      throw new Error(`+nav-list: unknown place "${unknown}", expected one of: ${places.join(', ')}`);
    }
  ul&attributes(attributes)
    each item in nav
      unless item.hideIn && item.hideIn.includes(place)
        li(class=itemClass)
          +link(item.title, item.href)(aria-current=item.id != null && item.id === current.id && 'page')

mixin logo(loadingAttr)
  a(href='index.html').logo&attributes(attributes)
    picture
      source(srcset='./img/logo-2' + '.webp' media='(forced-colors: active)')
      +img('./img/logo', `${site.name} - home`)(loading=loadingAttr).logo__img

mixin page-heading(data)
  hgroup.heading&attributes(attributes)
    h1.heading__title-page(id= data.id class=data.sizeTitle)!= data.title
    if data.subtitle
      p.heading__subtitle(class=data.sizeSubtitle)!= data.subtitle

mixin section-heading(data)
  hgroup.heading&attributes(attributes)
    h2.heading__title-section(id= data.id class=data.sizeTitle)!= data.title
    if data.subtitle
      p.heading__subtitle(class=data.sizeSubtitle)= data.subtitle

mixin button(name)
  a(href='#').button&attributes(attributes)
    span.button__text= name

mixin button-icon(name, icon, href)
  a(href=href || '#').button.button_icon&attributes(attributes)
    span.button__text= name
    +svg(icon).button__svg

mixin label-timer(time)
  div.label&attributes(attributes)
    +svg('timer').label__svg
    span.label__text= time

mixin label-category(category)
  a(href='#').label.label_link&attributes(attributes)
    +svg('fork-knife').label__svg
    span.label__text= category

mixin slide(data)
  article.slide&attributes(attributes)
    div.slide__content
      div.label.label_hot
        span.label__text.label__text_hot Hot Recipes
      hgroup.slide__title-wrapper
        h2.slide__title= data.title
        p.slide__subtitle= data.subtitle
      div.slide__labels
        +label-timer(data.timer).label_slide
        +label-category(data.category).label_slide
      div.slide__container
        div.author
          +img(data.authorPhoto, '').author__photo
          a(href='#').author__name= data.authorName
          +date(data.authorDate).author__date
        +button-icon('View Recipes', 'play', data.href)
    div.slide__img-wrapper
      +img('./img/handpicked', 'Handpicked')(loading=data.isFirst ? 'eager' : null).slide__handpicked
      +img(data.imgSlide, '')(
        loading=data.isFirst ? 'eager' : null,
        fetchpriority=data.isFirst ? 'high' : null,
        sizes='(max-width: 800px) calc(100vw - 32px), ' +
        '(max-width: 1024px) 36vw, ' +
        '(max-width: 1200px) 40vw, ' +
        '(max-width: 1400px) calc(51.5vw - 62px), 660px').slide__img

mixin post(data)
  a(href='#' target='_blank' rel='noopener' aria-label=`Open the Instagram post ${data.title} (opens in new tab)`).card-inst
    div.card-inst__header
      +img('./img/inst-logo', '').card-inst__avatar
      span.card-inst__acc Foodieland.
      span.card-inst__place Tokyo, Japan
      +svg('inst-more').card-inst__more
    div.card-inst__img-wrapper
      +img(data.img, '').card-inst__img
      div(aria-hidden='true').card-inst__number 1/3
    div(aria-hidden='true').card-inst__nav
      +svg('inst-like').card-inst__like
      +svg('inst-comment').card-inst__comment
      +svg('inst-messenger').card-inst__messenger
      +svg('inst-pagination').card-inst__pagination
      +svg('inst-save').card-inst__save
    div.card-inst__users-wrapper
      +img('./img/inst-avatar', '').card-inst__users-avatar
      span.card-inst__users-text Liked by #[strong craig_love] and #[strong 44,686 others]
      h3.card-inst__title #[strong(aria-hidden='true') Foodieland.] #{data.title}
      time(datetime='09-19').card-inst__date September 19

mixin recipe-big(data)
  article.card-recipe.card-recipe_big&attributes(attributes)
    div.card-recipe__img-wrapper
      +img(data.img, '').card-recipe__img.card-recipe__img_big
      button(
        type='button'
        aria-pressed=data.like ? 'true' : 'false'
        aria-label=`Like ${data.title}`).card-recipe__like.card-recipe__like_big.js-card-recipe-like
        +svg('like').card-recipe__svg
    h3.card-recipe__title-wrapper
      a(href=data.href || '#').card-recipe__title= data.title
    div.card-recipe__labels
      +label-timer('30 Minutes')
      +label-category(data.category)

mixin recipe-small(data)
  article.card-recipe&attributes(attributes)
    div.card-recipe__img-wrapper
      +img(data.img, '').card-recipe__img
      button(
        type='button'
        aria-pressed=data.like ? 'true' : 'false'
        aria-label=`Like ${data.title}`).card-recipe__like.js-card-recipe-like
        +svg('like').card-recipe__svg
    h3.card-recipe__title-wrapper
      a(href=data.href || '#').card-recipe__title.card-recipe__title_small= data.title
    div.card-recipe__labels
      +label-timer('30 Minutes')
      +label-category(data.category)

mixin card-list(data)
  article.card-list&attributes(attributes)
    div.card-list__img-wrapper
      +img(data.img, '').card-list__img
    div.card-list__container
      h2.card-list__title-wrapper
        a(href=data.href || '#').card-list__title= data.title
      p.card-list__subtitle= data.subtitle
      div.author.author_blog
        +img(data.authorPhoto, '').author__photo.author__photo_blog
        a(href='#').author__name.author__name_blog= data.authorName
        +date(data.authorDate).author__date.author__date_blog

mixin sidebar-card(data)
  li.sidebar__card
    div.sidebar__img-wrapper
      +img(data.img, '').sidebar__img
    div.sidebar__container
      h3.sidebar__title-wrapper
        a(href=data.href || '#').sidebar__title= data.title
      a(href='#').sidebar__author= `By ${data.authorName}`

mixin promo
  article.promo&attributes(attributes)
    h3.promo__title
      | Don’t forget to eat healthy food
    div.promo__media
      +img('./img/promo', 'Salad with grilled salmon').promo__img
    +external-link('www.foodieland.com', '#').promo__link

mixin search(name)
  search(aria-label=name)&attributes(attributes)
    form.input.input_search
      div.input__container
        label.visually-hidden(for='input-field')= name
        input.input__field.input__field_search(
          id='input-field'
          type='search'
          name='search'
          placeholder=`${name}...`)
        button(type='reset' aria-label='Clear search').input__clear
      button(type='submit').button.input__submit.js-input-submit
        span.button__text Search

mixin pagination(data)
  - const { total, baseHref = '?page=', siblings = 1 } = data;
  if total >= 1
    - const hasGaps = total > siblings * 2 + 5;
    nav.pagination.js-pagination(aria-label='pagination' data-siblings=siblings)&attributes(attributes)
      ul.pagination__list
        each page in Array.from({length: total}, (_, i) => i + 1)
          if hasGaps && page === total
            li.js-pagination-gap(hidden)
              span.pagination__dots …
          li(data-page=page)
            a.pagination__item.js-pagination-item(href=`${baseHref}${page}`)= page
          if hasGaps && page === 1
            li.js-pagination-gap(hidden)
              span.pagination__dots …
